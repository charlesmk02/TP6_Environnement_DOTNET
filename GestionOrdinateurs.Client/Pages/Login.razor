@page "/login"
@using System.IdentityModel.Tokens.Jwt
@using System.Text.Json.Serialization
@inject HttpClient Http
@inject ISessionStorageService SessionStorage
@inject NavigationManager Navigation

<PageTitle>Connexion Keycloak</PageTitle>

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Connexion à la flotte (Keycloak)</h4>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger" role="alert">
                        @errorMessage
                    </div>
                }

                <div class="mb-3">
                    <label for="loginInput" class="form-label">Identifiant :</label>
                    <input id="loginInput" class="form-control" placeholder="ex: user1, user2" @bind="login" />
                </div>

                <div class="mb-3">
                    <label for="passwordInput" class="form-label">Mot de passe :</label>
                    <input id="passwordInput" type="password" class="form-control" placeholder="Mot de passe" @bind="password" />
                    <small class="text-muted">Utilisateurs configurés dans Keycloak : user1 / password123, user2 / password123.</small>
                </div>

                <button class="btn btn-primary w-100" @onclick="SeConnecter" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span>Connexion en cours...</span>
                    }
                    else
                    {
                        <span>Se connecter</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private string login = string.Empty;
    private string password = string.Empty;
    private string? errorMessage;
    private bool isLoading = false;

    private class KeycloakTokenResponse
    {
        [JsonPropertyName("access_token")]
        public string AccessToken { get; set; } = string.Empty;

        [JsonPropertyName("token_type")]
        public string TokenType { get; set; } = string.Empty;
    }

    private async Task SeConnecter()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(login) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Veuillez renseigner votre identifiant et votre mot de passe.";
            return;
        }

        isLoading = true;

        try
        {
            // TP6.13 : Endpoint Keycloak pour obtenir le token
            var tokenEndpoint = "http://localhost:8180/realms/GestionOrdinateursRealm/protocol/openid-connect/token";

            var formData = new Dictionary<string, string>
            {
                { "client_id", "blazor-client" },
                { "grant_type", "password" },
                { "username", login },
                { "password", password }
            };

            var requestMessage = new HttpRequestMessage(HttpMethod.Post, tokenEndpoint)
            {
                Content = new FormUrlEncodedContent(formData)
            };

            var response = await Http.SendAsync(requestMessage);

            if (response.IsSuccessStatusCode)
            {
                var tokenResult = await response.Content.ReadFromJsonAsync<KeycloakTokenResponse>();

                if (tokenResult != null && !string.IsNullOrEmpty(tokenResult.AccessToken))
                {
                    await SessionStorage.SetItemAsync("authToken", tokenResult.AccessToken);

                
                    var handler = new JwtSecurityTokenHandler();
                    var jwt = handler.ReadJwtToken(tokenResult.AccessToken);
                    
                    var username = jwt.Claims.FirstOrDefault(c => c.Type == "preferred_username")?.Value ?? login;
                    await SessionStorage.SetItemAsync("userLogin", username);

                    // Extraction du rôle
                    string role = "User";
                    var realmAccessClaim = jwt.Claims.FirstOrDefault(c => c.Type == "realm_access")?.Value;
                    if (!string.IsNullOrEmpty(realmAccessClaim) && realmAccessClaim.Contains("Admin"))
                    {
                        role = "Admin";
                    }
                    await SessionStorage.SetItemAsync("userRole", role);

                    // Redirection vers l'accueil
                    Navigation.NavigateTo("/");
                }
            }
            else
            {
                errorMessage = "Identifiant ou mot de passe incorrect (Keycloak).";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Erreur de communication avec Keycloak : {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}