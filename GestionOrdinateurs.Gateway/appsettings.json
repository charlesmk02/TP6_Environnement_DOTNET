{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "http": {
        "Url": "http://0.0.0.0:5010"
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "ordinateurs-route": {
        "ClusterId": "gestion-ordinateurs-api",
        "Match": {
          "Path": "/ordinateurs/{**catch-all}"
        }
      },
      "reparations-route": {
        "ClusterId": "gestion-ordinateurs-api",
        "Match": {
          "Path": "/reparations/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "gestion-ordinateurs-api": {
        "Destinations": {
          "mainApi": {
            "Address": "http://gestionordinateurs-api:5019/"
          }
        }
      }
    }
  }
}